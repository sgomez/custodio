#!/bin/sh
# Make systemd and the bus see the new unit and policy, register the journal catalog and, after an upgrade of a running service,
# restart it once (F43; SPEC design section 2). The account was created by preinst. The service is never enabled or started here:
# D-Bus activation and its socket start it. Nothing here touches the state directory. The reloads tolerate failure (no live systemd in a chroot).
set -e
case "$1" in
configure)
    systemctl daemon-reload || true
    # The socket of the Firefox snap (F173) is enabled and started on install and upgrade, so a connection to it starts the
    # service. The service itself stays unenabled. Both tolerate failure: no live systemd in a chroot.
    systemctl enable custodio-firefox.socket || true
    deb-systemd-invoke reload dbus.service || true
    journalctl --update-catalog || true
    # preinst left the marker only if the service was running before this upgrade. Without it (an upgrade whose preinst did not
    # run to the end) the service is left alone and D-Bus activation starts the new binary on the next call.
    # systemd refuses to start a socket while its service is active (and a restart of the socket would leave it down), so a running
    # service is stopped first, the socket started, and the service restarted (started) after it.
    if [ -n "$2" ] && [ -e /run/custodio-restart-after-upgrade ]; then
        rm -f /run/custodio-restart-after-upgrade
        deb-systemd-invoke stop custodio.service || true
        deb-systemd-invoke start custodio-firefox.socket || true
        # Plain systemctl: deb-systemd-invoke refuses to start a static unit that is not running, and it was stopped just above.
        # policy-rc.d is asked first, as deb-systemd-invoke does: exit 0 and 104 allow the restart, anything else (101) forbids it.
        policy=0
        if [ -x /usr/sbin/policy-rc.d ]; then
            /usr/sbin/policy-rc.d custodio.service restart || policy=$?
        fi
        if [ "$policy" = 0 ] || [ "$policy" = 104 ]; then
            systemctl restart custodio.service || echo "custodio: could not restart custodio.service; the next D-Bus call starts the new binary." >&2
        fi
    else
        deb-systemd-invoke start custodio-firefox.socket || true
    fi
    # The notice is for a first install only: $2 is empty then. An upgrade, and a reinstall after a removal that was not a purge, have $2 set
    # and stay silent (conservative: the person decided on install). Nothing here runs the command or touches the login configuration.
    if [ -z "$2" ]; then
        {
            echo "custodio: Custodio's dialogs ask for your password; the fingerprint is off."
            echo "custodio: to let a finger answer them, and every other polkit dialog, run: sudo custodio setup fingerprint enable"
            echo "custodio: to check the setup at any time, run: custodio doctor"
        } >&2
    fi
    ;;
abort-upgrade | abort-remove | abort-deconfigure)
    rm -f /run/custodio-restart-after-upgrade
    ;;
esac
