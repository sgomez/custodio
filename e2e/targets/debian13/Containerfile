# Test machine for `just e2e`: Debian with systemd as PID 1, real polkit and logind, the tools that
# consume PKCS#11 modules, and Python for the test authentication agent. The Custodio package is
# NOT in the image: the test installs it, like a user would.
FROM debian:trixie

RUN apt-get -o APT::Sandbox::User=root update && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
      systemd systemd-sysv systemd-cron dbus dbus-user-session libpam-systemd polkitd p11-kit opensc pkcs11-provider \
      libnss3-tools openssl util-linux python3 python3-gi procps swtpm swtpm-tools tpm2-tools \
    && rm -rf /var/lib/apt/lists/*

# The container image ships /usr/sbin/policy-rc.d (exit 101: "do not start services in a container"); a real machine has none, and the
# maintainer scripts of the package would not restart the service on an upgrade with it. The test machine behaves like a real one.
RUN rm -f /usr/sbin/policy-rc.d

# The agent authenticates through PAM like a real one; accept any password for the polkit service
# so that "approve" needs no secret. The decision (approve or deny) is made by the agent.
RUN printf 'auth required pam_permit.so\naccount required pam_permit.so\n' > /etc/pam.d/polkit-1

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
