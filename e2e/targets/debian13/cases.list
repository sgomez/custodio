# Cases of this target only (apt-get purge cycle and reinstall), added to e2e/cases.list by e2e/run.sh; a target without this file that reports one fails.
# The purge cycle of F49 (apt-get purge), reported by the main guest run on the deb targets only.
purge-service-stopped
purge-no-packaged-files
purge-not-activatable
purge-state-unchanged
purge-account-kept
purge-notice-keys
reinstall-after-purge-keys-listed
reinstall-after-purge-signs-with-polkit
reinstall-after-purge-no-import
# F133: the kind a key gets with the TPM of the run (swtpm), in the import result, the API's list, `custodio list` and the journal. Skipped under the other modes (skip.list).
tpm-kind-import-rsa
tpm-kind-import-ec
tpm-kind-api-list
tpm-kind-cli-list
tpm-kind-journal
# F134: every mechanism signs under each kind; run in every TPM mode (swtpm, none, lacking), never skipped.
sign-kind-matches-mode
sign-rsa-pkcs
sign-rsa-pss-sha256
sign-rsa-pss-sha384
sign-rsa-pss-sha512
sign-rsa-composed
sign-ec-ecdsa
sign-ec-composed

# F135: no plaintext key in the state directory after each import; run in every TPM mode (swtpm, none, lacking), never skipped.
noplain-rsa
noplain-ec
noplain-no-key-file
tpm-dup-authpolicy-empty
tpm-dup-duplicate-fails
tpm-dup-other-tpm

# F137: every TPM and TPM-bound key still signs after PCRs are extended and the TPM and the service restarted; skipped in none (no TPM), run in swtpm and lacking.
pcr-extended-signs
pcr-restarted-signs
pcr-signs-every-key

# F138: the kind after import and what the CLI says (acceptance 6). The host cases run in none (kind encrypted-host); the tpmbound cases are skipped in every mode (SPEC_DEVIATIONS.md, F134).
fallback-host-import-rsa
fallback-host-import-ec
fallback-host-says-weaker-why
fallback-host-cli-list
fallback-tpmbound-import
fallback-tpmbound-cli-list

# F139: with a TPM present that fails in an injected way, and with the credential service down, import fails with the documented error, stores nothing, leaves one journal entry and makes no weaker kind (acceptance 7). Run in swtpm, skipped in none and lacking.
tpmfail-device-unopenable
tpmfail-tpm-error
tpmfail-credentials-down-tpm-lacking
tpmfail-credentials-down-host

# F140: signing after the TPM is cleared (acceptance 8): it fails with KeyLost and a journal entry, the keys are still listed and can be deleted. Run in swtpm and lacking, skipped in none (no TPM to clear).
tpm-clear-sign-fails
tpm-clear-keys-listed
tpm-clear-delete

# F143: more signatures and imports than the TPM has object slots (acceptance 10), and no object left loaded. Run in swtpm and lacking, skipped in none (no TPM, no slots).
tpm-slots-sign-rsa
tpm-slots-sign-ec
tpm-slots-import
tpm-slots-no-leak

# F141: the kind of the seeded keys before, after and in use around the N to N+1 upgrade (e2e/upgrade-kinds.sh); the kind depends on the TPM of the run, not on the distribution.
upgrade-kinds-before
upgrade-kinds-kept
upgrade-kinds-signs
upgrade-kinds-tpmbound
