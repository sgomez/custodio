# Test machine for the refusal case of `just e2e`: Ubuntu 24.04 (noble) with systemd as PID 1, real polkit and logind, and its DEFAULT bus daemon,
# dbus-daemon 1.14, which has no ProcessFD. no other bus daemon is ever installed. The Custodio package is NOT in the image: the test tries to install it.
FROM docker.io/library/ubuntu:24.04

RUN apt-get -o APT::Sandbox::User=root update && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
      systemd systemd-sysv dbus dbus-user-session libpam-systemd polkitd p11-kit openssl util-linux procps swtpm swtpm-tools tpm2-tools \
    && rm -rf /var/lib/apt/lists/*

# The image ships /usr/sbin/policy-rc.d (exit 101); a real machine has none.
RUN rm -f /usr/sbin/policy-rc.d

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
