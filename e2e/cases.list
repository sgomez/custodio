# Every case of the e2e suite, one id per line. A run must report each exactly once, as run or skipped (check-cases.sh).
# Adding a case to a script means adding it here; the host fails on a case that is missing, unknown or reported twice.
no-key-read
pkcs11-tool-approve-rsa
pkcs11-tool-deny
pkcs11-tool-asks-again
pkcs11-tool-approve-ecdsa
nss-approve
nss-deny
nss-asks-again
composed-SHA256-RSA-PKCS
composed-SHA384-RSA-PKCS
composed-SHA512-RSA-PKCS
composed-SHA256-RSA-PKCS-deny
composed-ECDSA-SHA256
composed-ECDSA-SHA384
composed-ECDSA-SHA512
composed-ECDSA-SHA256-deny
provider-rsa1
provider-ec1
provider-several-updates
provider-deny
login-approve-rsa
login-approve-ecdsa
login-asks-again
login-deny
login-context-specific
journal-signatures
polkit-unavailable
journal-entries
journal-catalog
