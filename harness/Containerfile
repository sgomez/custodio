# Dev container for the build loop: Linux, D-Bus, polkit, PKCS#11 and NSS tools, Rust and the
# cargo tools SPEC.md asks for, and Claude Code. The agent runs here with
# --dangerously-skip-permissions, so it only sees the mounted repository.
FROM debian:trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential clang lld pkg-config libssl-dev git curl ca-certificates sudo jq procps \
      dbus dbus-daemon polkitd systemd p11-kit opensc libnss3-tools \
      just shellcheck nodejs npm python3 python3-yaml rpm libarchive-tools zstd \
    && rm -rf /var/lib/apt/lists/*

# lintian for `just package-lint`, at the version of packaging/lint/pins.txt (a test keeps them in step) from the dated snapshot as the only
# apt source of this install, so a point release cannot remove it. rpmlint is not installed: Debian's is not the pinned Fedora one, so the
# gate runs rpmlint, and namcap (not packaged for Debian), in containers. podman (rootless, the host socket is never mounted) and uidmap run
# them; the storage driver is vfs (see docs/findings.md, F38).
ARG LINTIAN=2.122.0
ARG DEBIAN_SNAPSHOT=20261020T000000Z
RUN echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ trixie main" > /etc/apt/snapshot.list \
    && apt-get -o Dir::Etc::sourcelist=/etc/apt/snapshot.list -o Dir::Etc::sourceparts=/dev/null -o Acquire::Check-Valid-Until=false update \
    && apt-get -o Dir::Etc::sourcelist=/etc/apt/snapshot.list -o Dir::Etc::sourceparts=/dev/null install -y --no-install-recommends "lintian=${LINTIAN}" \
    && rm -rf /var/lib/apt/lists/* /etc/apt/snapshot.list \
    && test "$(lintian --print-version)" = "${LINTIAN}" \
    && apt-get update && apt-get install -y --no-install-recommends podman uidmap \
    && rm -rf /var/lib/apt/lists/*

# nfpm builds the .deb, .rpm and Arch packages (`just package`); keep the version in step with mise.toml and CI.
ARG NFPM_VERSION=2.48.0
ARG NFPM_SHA256=6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750
RUN curl -fsSLo /tmp/nfpm.tgz https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_Linux_x86_64.tar.gz \
    && echo "${NFPM_SHA256}  /tmp/nfpm.tgz" | sha256sum -c - \
    && tar -xzf /tmp/nfpm.tgz -C /usr/local/bin nfpm && rm /tmp/nfpm.tgz

RUN npm install -g lefthook
RUN curl -fsSL https://raw.githubusercontent.com/rhysd/actionlint/main/scripts/download-actionlint.bash \
      | bash -s -- latest /usr/local/bin

RUN useradd -m -s /bin/bash dev && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev && printf 'dev:1:999\ndev:1001:64535\n' | tee /etc/subuid > /etc/subgid
USER dev
RUN mkdir -p /home/dev/.config/containers \
    && printf '[storage]\ndriver = "vfs"\n[storage.options]\nignore_chown_errors = "true"\n' > /home/dev/.config/containers/storage.conf \
    && printf '[containers]\ndefault_sysctls = []\nnetns = "host"\nutsns = "host"\n' > /home/dev/.config/containers/containers.conf
ENV PATH=/home/dev/.cargo/bin:/home/dev/.local/bin:$PATH

# run.sh passes the pins from rust-toolchain.toml and the justfile's nightly_toolchain.
ARG STABLE=stable
ARG NIGHTLY=nightly
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$STABLE" \
      --component rustfmt,clippy,llvm-tools-preview \
    && rustup toolchain install "$NIGHTLY" --profile minimal --component miri,rust-src
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
      https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y cargo-deny cargo-machete cargo-mutants cargo-llvm-cov cargo-fuzz \
         taplo-cli zizmor git-cliff
RUN curl -fsSL https://claude.ai/install.sh | bash

WORKDIR /work
